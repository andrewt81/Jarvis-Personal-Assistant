# Copy to /opt/jarvis/deploy/release.env and protect it with mode 0600.
# The image must include a registry digest, never only a mutable tag.
JARVIS_IMAGE=ghcr.io/andrewt81/jarvis-personal-assistant/backend@sha256:replace-with-release-digest
JARVIS_SECRETS_GID=replace-with-getent-group-result
# Candidate local provider; not proof that connectivity or credentials are ready.
JARVIS_AI_PROVIDER=openwebui
JARVIS_OPENWEBUI_BASE_URL=http://100.127.56.71:3000
JARVIS_OPENWEBUI_MODEL=jarvis
# Set only after checking the full profile through an authorized admin account.
# Required when Open WebUI hides params from the service account (read access).
JARVIS_OPENWEBUI_PROFILE_VERSION_ID=
JARVIS_OPENWEBUI_TIMEOUT_SECONDS=3600
JARVIS_AI_API_KEY_HOST_FILE=/opt/jarvis/secrets/openwebui-api-key
# Existing dedicated application configuration on Jarvis, pointing to Edith.
JARVIS_POSTGRES_ENV_FILE=/opt/jarvis/config/postgresql.env
JARVIS_S3_ENV_FILE=/opt/jarvis/secrets/rustfs.env
