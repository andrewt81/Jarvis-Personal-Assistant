# Copy to /opt/jarvis/deploy/release.env and protect it with mode 0600.
# The image must include a registry digest, never only a mutable tag.
JARVIS_IMAGE=ghcr.io/andrewt81/jarvis-personal-assistant/backend@sha256:replace-with-release-digest
JARVIS_SECRETS_GID=replace-with-getent-group-result
JARVIS_AI_PROVIDER=openai
JARVIS_AI_MODEL=gpt-6-luna
JARVIS_AI_API_KEY_HOST_FILE=/opt/jarvis/secrets/openai-api-key
