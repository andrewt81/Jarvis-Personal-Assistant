JARVIS_ENVIRONMENT=development
JARVIS_HTTP_HOST=0.0.0.0
JARVIS_HTTP_PORT=8080
JARVIS_LOG_LEVEL=INFO

# PostgreSQL. In production the password is read from the mounted secret file.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis_app
POSTGRES_SSLMODE=require
POSTGRES_PASSWORD_FILE=/run/secrets/postgresql_password

# S3-compatible storage. Production values are supplied by the protected env file.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=jarvis-documents-dev
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Optional in development. Production enables OpenAI document understanding explicitly.
JARVIS_AI_PROVIDER=disabled
JARVIS_AI_MODEL=gpt-6-luna
JARVIS_AI_API_KEY_FILE=/run/secrets/openai_api_key
